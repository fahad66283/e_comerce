# HAK Store – database settings
# 1. Copy this file to a new file named .env  (same folder as package.json)
# 2. Fill in your MySQL details from Hostinger hPanel → Databases → Management
# 3. Restart the app. Tables and default data are created automatically on first start.
#
# Never commit the real .env file (it is ignored by git).

# Hostinger: use "localhost" when the website and the database are on the same hosting account.
DB_HOST=localhost
DB_PORT=3306

# Hostinger adds a prefix, e.g. u123456789_hakstore
DB_NAME=
DB_USER=
# Keep the double quotes, especially if the password contains # or spaces.
DB_PASSWORD=""

# Optional: maximum number of open database connections (default 5)
# DB_CONNECTION_LIMIT=5

# ---------------------------------------------------------------------
# Card payments with Stripe (optional – leave empty to hide card payments)
# ---------------------------------------------------------------------
# Stripe Dashboard → Developers → API keys → "Secret key".
# sk_test_... to try it with test cards, sk_live_... to take real payments.
STRIPE_SECRET_KEY=
# Stripe Dashboard → Developers → Webhooks → Add endpoint:
#   https://your-domain.com/api/stripe/webhook
#   events: checkout.session.completed, checkout.session.expired,
#           checkout.session.async_payment_succeeded, checkout.session.async_payment_failed
# then copy its "Signing secret" (whsec_...) here.
STRIPE_WEBHOOK_SECRET=
# Currency of your product prices (default pkr). Prices are charged as they are, not converted.
STRIPE_CURRENCY=pkr
# Your website address, used for the links back from Stripe's payment page.
SITE_URL=https://hakstores.com
